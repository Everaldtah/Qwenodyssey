{
  "name": "qwenodyssey",
  "version": "0.1.0",
  "description": "An Odyssey-class coding harness for Qwen 2.5 7B.",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "qwenodyssey": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "src/prompts",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "start": "node dist/cli/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "qwen",
    "coding-agent",
    "cli",
    "ollama",
    "llm",
    "code-generation",
    "ai-agent"
  ],
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "chalk": "^4.1.2",
    "commander": "^11.1.0",
    "diff": "^5.2.0",
    "execa": "^5.1.1",
    "fast-glob": "^3.3.2",
    "ora": "^5.4.1",
    "prompts": "^2.4.2",
    "simple-git": "^3.27.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^20.14.0",
    "@types/prompts": "^2.4.9",
    "typescript": "^5.6.3",
    "vitest": "^1.6.0"
  },
  "engines": {
    "node": ">=18"
  }
}
